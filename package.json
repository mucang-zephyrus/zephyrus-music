    "pinia": "^3.0.4",
    "pinyin-match": "^1.2.10",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "remixicon": "^4.7.0",
    "sass": "^1.96.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "tinycolor2": "^1.6.0",
    "tunajs": "^1.0.15",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^6.4.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-vue-devtools": "7.7.2",
    "vitest": "4.1.10",
    "vue": "^3.5.25",
