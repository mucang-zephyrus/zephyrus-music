{
  "name": "ZephyrusMusic",
  "version": "1.4.2",
  "description": "Zephyrus Music",
  "author": "Zephyrus <WEISTUDIOWEI@126.com>",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/mucang-zephyrus/zephyrus-music",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mucang-zephyrus/zephyrus-music.git"
  },
  "bugs": {
    "url": "https://github.com/mucang-zephyrus/zephyrus-music/issues"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write ./src",
    "lint": "eslint ./src --fix && npm run lint:i18n",
    "lint:i18n": "bun scripts/check_i18n.ts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dev:web": "vite dev",
    "build:web": "vite build",
    "dev:gateway": "node server-platform-login.js",
    "test:gateway": "node scripts/test-platform-gateway.mjs",
    "test:lyrics": "vitest run --config vitest.config.ts tests/lyrics",
    "fetch:song": "node scripts/fetch-song.mjs",
    "build:plugins": "node scripts/build-plugins.mjs --in-place",
    "workflow": "node scripts/workflow.mjs",
    "ci:local": "node scripts/workflow.mjs check",
    "release:android": "node scripts/workflow.mjs apk",
    "release:publish": "node scripts/workflow.mjs publish",
    "test:workflow": "vitest run --config vitest.config.ts tests/workflow && node scripts/workflow.mjs test",
    "start": "vite preview",
    "dev": "vite dev",
    "build": "npm run build:web"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,vue,js,css,scss,md,json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@applemusic-like-lyrics/core": "^0.6.0",
    "@applemusic-like-lyrics/vue": "^0.6.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@chenglou/pretext": "^0.0.8",
    "@types/three": "^0.185.4",
    "@unblockneteasemusic/server": "^0.27.10",
    "@yakult-green-tea/qq-music-api": "^3.3.5",
    "amll-mesh-core": "npm:@applemusic-like-lyrics/core@0.5.2",
    "cors": "^2.8.5",
    "crypto-js": "^4.2.0",
    "dompurify": "^3.4.11",
    "express": "^4.22.1",
    "form-data": "^4.0.5",
    "gsap": "^3.15.0",
    "husky": "^9.1.7",
