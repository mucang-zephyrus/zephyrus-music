    "jsencrypt": "^3.5.4",
    "kugoumusicapi": "https://codeload.github.com/MakcRe/KuGouMusicApi/tar.gz/refs/tags/v1.6.0",
    "mediabunny": "^1.56.1",
    "music-metadata": "^11.10.3",
    "node-fetch": "^2.7.0",
    "ogl": "^1.0.11",
    "opencc-js": "^1.4.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "qrc-decoder": "1.0.2",
    "qrcode": "^1.5.4",
    "three": "^0.185.1",
    "vue-i18n": "^11.2.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@eslint/js": "^9.39.2",
    "@rushstack/eslint-patch": "^1.15.0",
    "@types/dompurify": "^3.0.5",
    "@types/howler": "^2.2.12",
    "@types/node": "^20.19.26",
    "@types/node-fetch": "^2.6.13",
